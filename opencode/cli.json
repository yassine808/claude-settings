{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "permissions": "autoaccept",
    "new_location": "launch",
    "tps": true,
    "verbosity": "low"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "notifications": false,
    "sound": true,
    "volume": 0.20000000000000004
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "highlights": true
}
