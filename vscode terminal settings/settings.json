{
    "claudeCode.preferredLocation": "panel",
    "workbench.statusBar.visible": false,
    "editor.stickyScroll.enabled": false,
    "files.autoSave": "afterDelay",
    "explorer.confirmDelete": false,
    "gitlens.ai.model": "gitkraken",
    "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
    "terminal.integrated.stickyScroll.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "explorer.confirmDragAndDrop": false,
    "tabnine.experimentalAutoImports": true,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.fontFamily": "Cascadia Code, Consolas, monospace",
    "terminal.integrated.fontSize": 15,
    //"terminal.integrated.cursorStyle": "line",
    //"terminal.integrated.cursorBlinking": false,
    "terminal.integrated.scrollback": 1000000000000,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "Windows PowerShell": {
            "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor"
    },
    "editor.fontFamily": "Cascadia Code, Consolas, monospace",
    "editor.fontSize": 15,
    "editor.fontLigatures": true,
    "editor.inlayHints.fontFamily": "Cascadia Code, Consolas, monospace",
    "editor.inlayHints.fontSize": 13,
    "chat.editor.fontFamily": "Cascadia Code, Consolas, monospace",
    "debug.console.fontFamily": "Cascadia Code, Consolas, monospace",
    "debug.console.fontSize": 15,
    "markdown.preview.fontFamily": "Cascadia Code, Consolas, monospace",
    "notebook.output.fontFamily": "Cascadia Code, Consolas, monospace",
    "vscode_vibrancy.type": "tabbed",
    "vscode_vibrancy.opacity": 0.6,
    "vscode_vibrancy.blur": 3,
    "vscode_vibrancy.theme": "Paradise Frosted Glass",
    "workbench.colorCustomizations": {
        // transparent = glass effect shows through
        "terminal.background": "#ocococ00",
        "terminal.foreground": "#ececec",
        "terminal.ansiBlack": "#1a1916",
        "terminal.ansiWhite": "#d4d3ce",
        "terminal.ansiBrightBlack": "#6b6a65",
        "terminal.ansiBrightWhite": "#fafaf8",
        "terminal.ansiBlue": "#0066cc",
        "terminal.ansiBrightBlue": "#00ff37c7",
        "terminal.ansiCyan": "#007a7a",
        "terminal.ansiBrightCyan": "#009999",
        "terminal.ansiGreen": "#1a7a1a",
        "terminal.ansiBrightGreen": "#2d9e2d",
        "terminal.ansiRed": "#cc3300",
        "terminal.ansiBrightRed": "#e74856",
        "terminal.ansiMagenta": "#8833cc",
        "terminal.ansiBrightMagenta": "#a855f7",
        "terminal.ansiYellow": "#ffee00",
        "terminal.ansiBrightYellow": "#0077ff",
        "terminalCursor.foreground": "#ffffff",
        "terminal.selectionBackground": "#003169",
        "editorPane.background": "#00000000",
        "editorGroupHeader.tabsBackground": "#00000000",
        "editorGroupHeader.noTabsBackground": "#00000000",
        "breadcrumb.background": "#00000000",
        "editorGutter.background": "#00000000",
        "panel.background": "#00000000",
        "panelStickyScroll.background": "#00000000",
        "tab.activeBackground": "#00000000",
        "tab.unfocusedActiveBackground": "#00000000",
        "sideBar.background": "#00000000",
        "sideBarTitle.background": "#00000000",
        "sideBarStickyScroll.background": "#00000000",
        "activityBar.background": "#00000000",
        "editor.background": "#00000000",
        "editorStickyScroll.background": "#00000000",
        "editorStickyScrollGutter.background": "#00000000",
        "tab.inactiveBackground": "#00000000",
        "tab.unfocusedInactiveBackground": "#6e222200",
        "inlineChat.background": "#1e1e1e44",
        "editorWidget.background": "#1e1e1e44",
        "editorHoverWidget.background": "#1e1e1e44",
        "editorSuggestWidget.background": "#1e1e1e44",
        "notifications.background": "#1e1e1e44",
        "notificationCenterHeader.background": "#1e1e1e44",
        "menu.background": "#1e1e1e44",
        "quickInput.background": "#1e1e1e"
    },
    "workbench.colorTheme": "Dark+",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "window.controlsStyle": "custom"
}